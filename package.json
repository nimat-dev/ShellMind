{
  "name": "shellmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check-architecture": "./scripts/check-architecture.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check-architecture"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.5"
  }
}
